# How to use:
# 1) This is the only env template in the repository (single source of truth).
# 2) Copy this file to .env when you want to override runtime defaults.
# 3) Frontend runtime defaults are in frontend-app/src/app/api/env.ts.
# 4) Backend runtime defaults are in backend-app/.../Infrastructure/Configuration/RuntimeSettings.cs.
# 5) You can override backend values either by env vars OR appsettings.Development.json.

# Docker / Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workoutdb
POSTGRES_USER=workout_user
POSTGRES_PASSWORD=workout_pass

# Backend (.NET) env overrides (used in Docker/CI/system env)
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Host=localhost;Port=5432;Database=workoutdb;Username=workout_user;Password=workout_pass
Jwt__Issuer=ApiModule
Jwt__Audience=ApiModule.Client
Jwt__Key=dev-only-change-me-to-at-least-32-characters
Jwt__ExpiresMinutes=120

# Frontend (Next.js)
NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_API_URL=http://localhost:5064/api